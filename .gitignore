cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local multi-GB lookup benchmark data; keep benchmark scripts reviewable.
/scratch/*.u8

# Evaluation tests need writable caches under the workspace sandbox.
/scratch/eval-test-temp-*/
/scratch/eval-suite-temp-*/
/scratch/eval-datasets-cache/
/scratch/eval-pytest-cache/
/scratch/independent-eval/*.partial
/scratch/independent-eval/*.tmp

# Keep the bounded widening probe results, not its multi-GB training checkpoint.
/scratch/widened-residual/smoke-checkpoint/
# Evaluation bundles are large and deterministic: `independent_eval prepare` rebuilds
# them byte for byte, and every result JSON records the bundle's sha256. The original
# 32-document text-bundle.json stays committed as the smallest reproducible example.
/scratch/independent-eval/*-bundle-*.json
# Per-task intermediates; the merged result beside them carries the same records.
/scratch/independent-eval/*.nll.json
/scratch/independent-eval/*.mmlu.json
/scratch/independent-eval/*.arc.json

# Screen outputs: keep RESULTS.md and the loading audit, ignore the 12 MB of JSON.
/scratch/eval-20260910/*.json
/scratch/eval-20260910/*.json.partial
/scratch/eval-20260910/*.log
!/scratch/eval-20260910/legacy-loading-audit.json
/scratch/eval-screen/
# Rebuildable donor-reader captures (held-out rows and four-stream tensors are tens of
# MB); keep their compact JSON/Markdown analyses reviewable.
/scratch/donor-reader-*.npz
