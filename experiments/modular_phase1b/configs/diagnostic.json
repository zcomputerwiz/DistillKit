{
  "phase": "modular_phase1b_binding_reader_diagnostic",
  "source_phase1_config": "experiments/modular_phase1/configs/pilot.json",
  "source_phase1_run_dir": "scratch/modular-phase1",
  "seed": 11,
  "model": {
    "layers": 2,
    "width": 64,
    "heads": 4,
    "sequence_length": 512,
    "batch_size": 64,
    "reader_window": 7,
    "arms": ["current_window", "exact_value"]
  },
  "data": {
    "query_kind": "lookup",
    "exclude_literals": true,
    "base_documents_only": true
  },
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 0.0003,
    "betas": [0.9, 0.95],
    "epsilon": 1e-8,
    "weight_decay": 0.1,
    "gradient_clip": 1.0,
    "schedule": "constant"
  },
  "budget": {
    "targets_per_run": 1048576,
    "whole_diagnostic_accelerator_seconds": 600
  },
  "runtime": {"device": "cuda:0", "bf16": true}
}
