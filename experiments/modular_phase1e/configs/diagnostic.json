  "features": [
    "event_probability_0", "event_probability_1", "event_probability_2",
    "event_probability_3", "event_probability_4", "event_probability_5",
    "event_probability_6", "event_probability_7", "event_probability_8",
    "event_probability_9", "event_probability_10", "event_probability_11",
    "event_probability_12", "event_probability_13", "event_probability_14",
    "event_probability_15", "event_probability_16", "validity_probability",
    "event_confidence", "programmed_scope_depth", "current_is_whitespace",
    "current_is_answer_marker", "fixed_scale_causal_position",
    "backbone_bit_probability", "backbone_bit_log_odds", "backbone_entropy"
  ],
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 0.05,
    "betas": [0.9, 0.95],
    "epsilon": 1e-8,
