  "acceptance": {
    "minimum_full_accuracy_gain": 0.05,
    "minimum_conditional_accuracy": 0.99,
    "minimum_intervention_accuracy": 0.99,
    "maximum_whitespace_nll_degradation": 0.02,
    "maximum_other_nonanswer_nll_degradation": 0.02,
    "maximum_false_bit_emission_increase": 0.01,
    "probability_preservation_tolerance": 1e-6,
    "bootstrap_samples": 2000
  },
  "budget": {"whole_run_accelerator_seconds": 300},
  "runtime": {"device": "cuda:0", "bf16": true}
}
