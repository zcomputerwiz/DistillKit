{
  "phase": "modular_phase1e_category_admission",
  "source_phase1_config": "experiments/modular_phase1/configs/pilot.json",
  "source_phase1_run_dir": "scratch/modular-phase1",
  "source_phase1b_run_dir": "scratch/modular-phase1b",
  "source_phase1c_run_dir": "scratch/modular-phase1c",
  "source_phase1d_run_dir": "scratch/modular-phase1d",
  "base_checkpoint": "scratch/modular-phase1/backbones/l6_w256/plain/seed_11/checkpoint.pt",
  "specialist_checkpoint": "scratch/modular-phase1d/specialist/specialist.pt",
  "readout_checkpoint": "scratch/modular-phase1c/readout.pt",
  "seed": 1801,
  "data": {
    "train_families": 1024,
    "calibration_families": 256,
    "confirmation_families": 256,
    "variants_per_family": ["base", "renamed", "whitespace"]
